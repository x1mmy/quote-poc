# Next.js loads .env and .env.local (do not commit real keys)
GEMINI_API_KEY=

# Optional override (default: gemini-2.5-flash). If you see free-tier quota errors on 2.x, try:
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-1.5-flash

# Supabase (service role — server only, never expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
